\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces Distribution of effective normal stress on the failure plane in the calibration database (741 tests).}}{1}{figure.caption.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces Net volumetric strain at the maximum deviator (negative: contraction) and breakage index of Marsal (1973) versus $\sigma '_n$ in the calibration database. Reported breakage indices above 100\%, impossible by definition, were excluded (4 tests). Above 1.5 MPa the residuals of HiBER increased with the volumetric compression (Spearman $\rho $ = 0.38, n = 122) and, above 2.75 MPa, with the breakage index ($\rho $ = 0.24, n = 91).}}{2}{figure.caption.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces Profile of the observed-data log-likelihood (censoring and truncation included) of the asymptotic angle $\phi '_\infty $ relative to its maximum (797.48); at each angle $\zeta _0$, the fixed effects, and the variance parameters were refitted. $\phi '_\infty $ = 0 is the form without an asymptote (approximate: maximum over two values of $\zeta _0$). Dashed: 1.92 units (approximate 95\% interval); dotted: 3 units. First-order approximation; see Table S3.}}{2}{figure.caption.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces Within-material specimen-size coefficient $\beta _D$ by laboratory (bars: 95\% confidence intervals; set intercepts adjusted for void ratio). Hatched band: Knapp--Hartung 95\% confidence interval of the random-effects mean across 7 laboratories with size ratio $\ge $ 2 (+0.029; $-$0.034 to +0.093); between-laboratory standard deviation $\tau _D$ = 0.066.}}{3}{figure.caption.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces Shares of the variance of the mean-envelope ln $\tau $ for an untested material of low rock quality placed at e = 0.65, scaled from 100 mm to 1 m maximum particle size, at three normal stresses.}}{3}{figure.caption.5}\protected@file@percent }
