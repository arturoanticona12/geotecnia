\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces Distribution of effective normal stress on the failure plane in the calibration database.}}{1}{figure.caption.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces Net volumetric strain at the maximum deviator (negative: contraction) and breakage index of Marsal (1973) versus $\sigma '_n$ in the calibration database; shaded: $\sigma '_n$ > 2.75 MPa. Reported breakage indices above 100\%, which are impossible by definition, were excluded (4 tests). Above 2.75 MPa the residuals of Leps-P were unrelated to the breakage index (Spearman $\rho $ = 0.00, n = 91).}}{2}{figure.caption.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces Profile log-likelihood of the asymptotic angle $\phi '_\infty $ relative to its maximum (1685.51); at each angle the population decay rate $\zeta _0$ and the variance parameters were re-estimated by maximum likelihood. $\phi '_\infty $ = 0 corresponds to the form without an asymptote. Dashed: 3 log-likelihood units below the maximum.}}{3}{figure.caption.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces Within-material specimen-size coefficient $\beta _D$ (bars: 95\% confidence intervals; set intercepts adjusted for void ratio). Hatched band: Knapp--Hartung 95\% confidence interval of the random-effects mean across 12 publications with size ratio $\ge $ 2 (+0.041; $-$0.001 to +0.084). One value outside the axis is annotated.}}{4}{figure.caption.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces Shares of the variance of the mean-envelope ln $\tau $ for an untested material of low rock quality placed at e = 0.65, scaled from 0.18 m to 1 m maximum particle size.}}{5}{figure.caption.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {S1}{\ignorespaces Mode B: every procedure evaluated (held-out tests at $\sigma '_n$ $\ge $ 2 MPa predicted from tests at $\sigma '_n$ $\le $ 1.5 MPa of the same set)}}{6}{table.caption.6}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {S2}{\ignorespaces Secant friction angle $\phi '_s$ (\textdegree {}) of the waste rock of the example, median / 5th percentile of the mean envelope}}{6}{table.caption.7}\protected@file@percent }
